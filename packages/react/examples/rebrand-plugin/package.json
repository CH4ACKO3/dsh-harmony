{
  "name": "dsh-example-rebrand",
  "version": "0.1.0",
  "private": true,
  "main": "./index.cjs",
  "exports": {
    ".": "./index.cjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./harmony.patch.yml"
    },
    "client": {
      "immediately": true,
      "platform": "web"
    },
    "harmony": {
      "patches": ["./patch.cjs"]
    }
  },
  "dependencies": {
    "dsh-harmony-react": "file:../.."
  }
}
